{
  "name": "daneobang",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "pnpm --filter @daneobang/web dev",
    "dev:mobile": "pnpm --filter @daneobang/mobile start",
    "build": "turbo build",
    "build:web": "pnpm --filter @daneobang/web build",
    "start:web": "pnpm --filter @daneobang/web start",
    "setup:web": "pnpm --filter @daneobang/web setup",
    "typecheck": "turbo typecheck",
    "test": "turbo test"
  },
  "devDependencies": {
    "turbo": "^2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "@tailwindcss/oxide",
      "esbuild",
      "prisma",
      "sharp",
      "react-native-reanimated"
    ]
  }
}
