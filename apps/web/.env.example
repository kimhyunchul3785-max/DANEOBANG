# 단어방 환경변수 예시 — start-server.bat 이 자동으로 .env 로 복사합니다
DATABASE_URL="file:./prisma/dev.db"
APP_URL="http://localhost:3000"
# 세션 서명 키 (운영 시 32자 이상 임의 문자열로 반드시 변경)
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# 개발용 이메일 로그인 허용 (운영에서는 false 로 두고 구글/카카오만 사용)
ALLOW_DEV_LOGIN="true"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# 승인된 리디렉션 URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Kakao Login (https://developers.kakao.com) — 카카오 로그인 활성화, 동의항목: 닉네임·이메일
# Redirect URI: http://localhost:3000/api/auth/callback/kakao
KAKAO_CLIENT_ID=""
KAKAO_CLIENT_SECRET=""

# 업로드/PDF/사진 저장 경로 (기본: ./storage)
STORAGE_DIR="./storage"

# 조작 로그 폴더 (apps/web 기준 상대 경로. 기본: 저장소 루트의 log = DANEOBANG\log)
LOG_DIR="../../log"

# ── 메일 (이메일 인증 · 선생님 초대 · 학생 계정 설정 링크)
# 비워 두면 "개발 모드": 보내지 않고 log/mail.log 에 기록하며 화면에 링크를 직접 보여줍니다.
# 예: SMTP_URL="smtps://user%40gmail.com:app-password@smtp.gmail.com:465"  (또는 SMTP_HOST/SMTP_PORT/SMTP_USER/SMTP_PASS)
SMTP_URL=""
MAIL_FROM="단어방 <no-reply@example.com>"

# ── 과금 (학원 단위 · 선생님 Seat × 월 9,900원)
# mock = PG 연동 전 테스트 결제 (아무 카드나 승인, 끝자리 0000 은 실패). 실제 PG 연동 시 provider 이름으로 교체.
BILLING_PROVIDER="mock"

# ── 문자(SMS) — 학생 휴대폰 인증번호
# 비워 두면 개발 모드: 보내지 않고 log/sms.log 에 기록하며 선생님 화면에 인증번호를 그대로 보여줍니다(카톡 등으로 직접 전달).
SMS_PROVIDER=""

# ── 결제 기능 스위치 (체험 기간에는 꺼 둠). "true" 로 바꾸면 가입 단계 선생님 수·결제, 요금제 화면, Seat 제한이 켜집니다.
BILLING_ENABLED="false"

# ── OCR (사진 여러 장 · 스캔 PDF 단어장) — OpenAI 비전 모델
# 키가 없으면 사진 업로드가 막히고, 텍스트 없는 PDF 는 "OPENAI_API_KEY 필요" 안내가 나옵니다.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.6-luna"
# 동시에 보낼 요청 수(사진 장 수·PDF 묶음 수 기준). 스캔 PDF 는 한 요청에 몇 쪽씩 묶을지
OPENAI_CONCURRENCY="4"
OCR_PAGES_PER_CHUNK="3"
